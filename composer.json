{
  "name": "websonette/application-mcp-server",
  "description": "Reusable MCP server integration, authorization, audit, approvals and agent skills for PHP applications.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-openssl": "*",
    "ext-curl": "*",
    "lcobucci/jwt": "^5.6",
    "league/oauth2-server": "^9.3",
    "mcp/sdk": "^0.8.1",
    "nette/di": "^3.2",
    "nyholm/psr7": "^1.8",
    "nyholm/psr7-server": "^1.1",
    "opis/json-schema": "^2.4",
    "psr/clock": "^1.0",
    "psr/http-message": "^2.0",
    "psr/http-server-handler": "^1.0",
    "psr/log": "^3.0",
    "symfony/uid": "^7.4 || ^8.0"
  },
  "require-dev": {
    "nette/database": "^3.2",
    "nette/http": "^3.3",
    "nette/security": "^3.2",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "Websonette\\ApplicationMcpServer\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Websonette\\ApplicationMcpServer\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/websonette-mcp"
  ],
  "scripts": {
    "analyse": "phpstan analyse",
    "tests": "phpunit",
    "test": [
      "@composer validate --strict",
      "@tests",
      "@analyse",
      "@composer audit"
    ]
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "suggest": {
    "nette/database": "Share Nette Database connections and transaction ownership.",
    "nette/http": "Nette session-backed consent and HTTP bridge.",
    "nette/security": "Default Nette identity adapter."
  },
  "support": {
    "issues": "https://github.com/Websonette/application-mcp-server/issues",
    "source": "https://github.com/Websonette/application-mcp-server"
  }
}
